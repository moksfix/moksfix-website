---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { PageHero, BlogGrid, CtaBand } from '../../components/islands/Pages';
import { site } from '../../data/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const cards = posts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  excerpt: p.data.excerpt ?? p.data.description,
  category: p.data.category,
  date: fmt(p.data.publishDate),
  readingTime: p.data.readingTime,
  featured: p.data.featured,
}));
const categories = [...new Set(posts.map((p) => p.data.category))];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${site.name} Blog`,
    url: `${site.url}/blog`,
    description: 'Practical guides on web design, web & mobile app development, software and growing a business online — from the MoksFix studio in Coimbatore.',
    publisher: { '@id': `${site.url}/#organization` },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${site.url}/blog/${p.id}`,
      datePublished: p.data.publishDate.toISOString(),
      author: { '@type': 'Organization', name: p.data.author },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
    ],
  },
];
---

<Base
  title="Blog — Web Design, App Development & Business Guides | MoksFix"
  description="Practical guides on website cost, web and mobile app development, software for small businesses and growing online — from the MoksFix studio in Coimbatore."
  path="/blog"
  schema={schema}
>
  <PageHero
    client:load
    kicker="The MoksFix blog"
    title="Straight answers for"
    gold="growing businesses."
    sub="What a website really costs, how long an app takes, and the software that saves small businesses hours every week — written by the people who build it."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
    actions={false}
  />
  <BlogGrid client:load posts={cards} categories={categories} />
  <CtaBand client:visible title="Have a project" gold="in mind?" />
</Base>
